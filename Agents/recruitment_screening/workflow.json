{
  "workflow_name": "recruitment_screening",
  "version": "1.0.0",
  "description": "Baseline 8-agent recruitment and resume screening workflow for candidate qualification evaluation.",
  "fixed_model": "openai/gpt-oss-120b",
  "baseline_model": "openai/gpt-oss-120b",
  "assigned_groq_key_env": "GROQ_API_KEY_5",
  "llm_provider": "Groq",
  "total_agents": 8,
  "agent_count": 8,
  "execution_pattern": "sequential",
  "execution_order": [
    "resume_intake_agent",
    "qualification_agent",
    "job_criteria_agent",
    "evidence_mapping_agent",
    "experience_assessment_agent",
    "missing_evidence_agent",
    "screening_review_agent",
    "recruiter_summary_agent"
  ],
  "agents": [
    {
      "agent_id": "resume_intake_agent",
      "agent_name": "Resume Intake Agent",
      "role": "Resume Intake Specialist",
      "responsibilities": "Normalize input, catalog sections, verify completeness, extract candidate metadata.",
      "input_fields": ["application_id", "candidate_id", "sections", "source_evidence_ids"],
      "output_fields": ["application_id", "candidate_id", "candidate_name", "sections_identified", "missing_sections", "raw_sections"],
      "dependencies": []
    },
    {
      "agent_id": "qualification_agent",
      "agent_name": "Qualification Extraction Agent",
      "role": "Candidate Qualification Extractor",
      "responsibilities": "Extract skills, degrees, certifications, and experience linked to evidence IDs.",
      "input_fields": ["candidate_id", "raw_sections", "source_evidence_ids"],
      "output_fields": ["technical_skills", "education", "certifications", "experience_records", "projects"],
      "dependencies": ["resume_intake_agent"]
    },
    {
      "agent_id": "job_criteria_agent",
      "agent_name": "Job Criteria Agent",
      "role": "Job Criteria Analyst",
      "responsibilities": "Decompose job descriptions into discrete mandatory and preferred criteria with stable IDs.",
      "input_fields": ["job_id", "title", "mandatory_criteria", "preferred_criteria"],
      "output_fields": ["job_id", "job_title", "mandatory_criteria", "preferred_criteria", "total_criteria_count"],
      "dependencies": []
    },
    {
      "agent_id": "evidence_mapping_agent",
      "agent_name": "Evidence Mapping Agent",
      "role": "Candidate Evidence Mapping Specialist",
      "responsibilities": "Map criteria to qualifications, classify support status, preserve evidence references.",
      "input_fields": ["technical_skills", "education", "experience_records", "mandatory_criteria", "preferred_criteria"],
      "output_fields": ["mappings", "supported_count", "unsupported_count", "partially_supported_count"],
      "dependencies": ["qualification_agent", "job_criteria_agent"]
    },
    {
      "agent_id": "experience_assessment_agent",
      "agent_name": "Experience Assessment Agent",
      "role": "Experience Assessment Evaluator",
      "responsibilities": "Evaluate career relevance, identify transferable competencies, document strengths and gaps.",
      "input_fields": ["experience_records", "mappings"],
      "output_fields": ["relevance_summary", "strengths", "experience_gaps", "transferable_skills"],
      "dependencies": ["qualification_agent", "evidence_mapping_agent"]
    },
    {
      "agent_id": "missing_evidence_agent",
      "agent_name": "Missing Evidence and Consistency Agent",
      "role": "Recruitment Consistency and Verification Auditor",
      "responsibilities": "Detect timeline contradictions, unsupported buzzwords, missing evidence, unverified claims.",
      "input_fields": ["raw_sections", "mappings"],
      "output_fields": ["missing_evidence_items", "unreliable_requirements", "inconsistencies"],
      "dependencies": ["resume_intake_agent", "evidence_mapping_agent"]
    },
    {
      "agent_id": "screening_review_agent",
      "agent_name": "Screening Review Agent",
      "role": "Screening Quality and Integrity Reviewer",
      "responsibilities": "Audit upstream findings for contradictions, verify traceability, confirm mandatory criteria.",
      "input_fields": ["mappings", "strengths", "experience_gaps", "inconsistencies"],
      "output_fields": ["review_passed", "contradictions_detected", "traceability_verified", "mandatory_criteria_met", "issues_requiring_human_review"],
      "dependencies": ["evidence_mapping_agent", "experience_assessment_agent", "missing_evidence_agent"]
    },
    {
      "agent_id": "recruiter_summary_agent",
      "agent_name": "Recruiter Summary Agent",
      "role": "Executive Recruiter Summary Synthesizer",
      "responsibilities": "Produce final recruiter report, interview questions, deterministic match score, and human review notices.",
      "input_fields": ["candidate_overview", "criteria_matrix", "strengths", "gaps", "inconsistencies", "review_issues"],
      "output_fields": ["run_id", "application_id", "candidate_name", "job_title", "criteria_matrix", "key_strengths", "evidence_gaps", "deterministic_match_score", "human_review_required"],
      "dependencies": ["screening_review_agent"]
    }
  ],
  "baseline_execution_order": [
    "resume_intake_agent",
    "qualification_agent",
    "job_criteria_agent",
    "evidence_mapping_agent",
    "experience_assessment_agent",
    "missing_evidence_agent",
    "screening_review_agent",
    "recruiter_summary_agent"
  ],
  "optimization_opportunities": {
    "parallel_candidates": ["qualification_agent + job_criteria_agent", "experience_assessment_agent + missing_evidence_agent"],
    "pruning_candidates": ["screening_review_agent"],
    "consolidation_candidates": ["resume_intake_agent + qualification_agent"]
  },
  "optimizer_annotations": {
    "potential_parallel_branches": [
      ["qualification_agent", "job_criteria_agent"],
      ["experience_assessment_agent", "missing_evidence_agent"]
    ],
    "consolidation_candidates": [
      ["resume_intake_agent", "qualification_agent"],
      ["evidence_mapping_agent", "missing_evidence_agent"]
    ],
    "pruning_candidates": [
      "screening_review_agent"
    ],
    "routing_conditions": {
      "fast_track_low_skill_gap": "If candidate lacks multiple core mandatory criteria at intake, bypass deep experience assessment and jump to concise summary."
    }
  },
  "validation_requirements": {
    "output_schema": "RecruiterSummaryOutput",
    "mandatory_human_review": true,
    "disallow_autonomous_hiring": true
  }
}
