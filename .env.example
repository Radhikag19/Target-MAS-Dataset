# Groq Model Configuration (Mandatory: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# 4 Dedicated Workflow Groq API Keys (1 key per workflow)
# Workflow 1: Invoice Processing & Accounts Payable (8 agents)
GROQ_API_KEY_1=your_groq_api_key_for_workflow_1_here
# GROQ_API_KEY_INVOICE_PROCESSING=your_groq_api_key_for_workflow_1_here

# Workflow 2: Customer Support Ticket Resolution (6 agents)
GROQ_API_KEY_2=your_groq_api_key_for_workflow_2_here
# GROQ_API_KEY_CUSTOMER_SUPPORT=your_groq_api_key_for_workflow_2_here

# Workflow 3: Procurement & Supplier Selection (9 agents)
GROQ_API_KEY_3=your_groq_api_key_for_workflow_3_here
# GROQ_API_KEY_PROCUREMENT=your_groq_api_key_for_workflow_3_here

# Workflow 4: Sales Lead Qualification (7 agents)
GROQ_API_KEY_4=your_groq_api_key_for_workflow_4_here
# GROQ_API_KEY_SALES_LEAD=your_groq_api_key_for_workflow_4_here

# Workflow 5: Recruitment and Resume Screening (8 agents)
GROQ_API_KEY_5=your_groq_api_key_for_workflow_5_here
# GROQ_API_KEY_RECRUITMENT=your_groq_api_key_for_workflow_5_here

# Workflow 6: Inventory Replenishment Planning (6 agents)
GROQ_API_KEY_6=your_groq_api_key_for_workflow_6_here
# GROQ_API_KEY_INVENTORY=your_groq_api_key_for_workflow_6_here

# Workflow 7: Contract Review and Compliance (10 agents)
GROQ_API_KEY_7=your_groq_api_key_for_workflow_7_here
# GROQ_API_KEY_CONTRACT_REVIEW=your_groq_api_key_for_workflow_7_here

# Workflows 8 to 10: IT Incident Triage, Expense Reimbursement, Market Research (Keys 8 to 14)
GROQ_API_KEY_8=your_groq_api_key_8_here
GROQ_API_KEY_9=your_groq_api_key_9_here
GROQ_API_KEY_10=your_groq_api_key_10_here
GROQ_API_KEY_11=your_groq_api_key_11_here
GROQ_API_KEY_12=your_groq_api_key_12_here
GROQ_API_KEY_13=your_groq_api_key_13_here
GROQ_API_KEY_14=your_groq_api_key_14_here

# Arize Phoenix Tracing (Local Phoenix runs on http://localhost:6006 with NO key needed)
PHOENIX_PROJECT_NAME=agentic-workflow-optimizer
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
# PHOENIX_API_KEY=optional_cloud_key

